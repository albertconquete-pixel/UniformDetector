{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wokwi ESP-IDF Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/LCD_project.elf", 
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${command:espIdf.getToolchainGdb}", 
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
        }
      ]
    }
  ]
}
